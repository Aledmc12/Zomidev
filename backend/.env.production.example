# Copiar a backend/.env.production en el VPS — NUNCA subir a Git
# Generar SECRET_KEY: openssl rand -hex 32
# Generar REDIS_PASSWORD: openssl rand -base64 32

SECRET_KEY=
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

ALLOWED_ORIGINS=https://zomidev.com,https://www.zomidev.com
FRONTEND_URL=https://zomidev.com
ALLOWED_HOSTS=zomidev.com,www.zomidev.com,backend

# Nginx local hace proxy; Cloudflare envia CF-Connecting-IP
TRUSTED_PROXY_HOSTS=127.0.0.1

RESEND_API_KEY=
FROM_EMAIL=noreply@zomidev.com
CONTACT_EMAIL=aledmc@zomidev.com

# Solo si aun no ejecutaste seed en Supabase
SEED_ADMIN_EMAIL=admin@zomidev.com
SEED_ADMIN_PASSWORD=
SEED_CLIENT_EMAIL=cliente@ejemplo.com
SEED_CLIENT_PASSWORD=

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# Opcional
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
