# Copiar a docker/.env y completar (NO subir a Git)

REDIS_PASSWORD=genera_con_openssl_rand_base64_32
NEXT_PUBLIC_SITE_URL=https://zomidev.com

# Puerto del nginx dedicado de ZomiDev en la IP docker0 del host (default 172.17.0.1).
# WingConcept nginx (contenedor) hace proxy: zomidev.com → 172.17.0.1:8080
# Verificar IP: ip -4 addr show docker0 | grep inet
ZOMIDEV_NGINX_BIND=172.17.0.1
ZOMIDEV_NGINX_PORT=8080
